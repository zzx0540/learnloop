# Generate .env with: python tools/setup.py
# Never commit .env. Values below are deliberately blank.
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
INITIAL_INVITE_CODE=
ENV=dev
COOKIE_SECURE=false
LEARNLOOP_PORT=8080
# One OpenAI-compatible endpoint is enough for ordinary knowledge courses.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
MODEL_LOW=
# Optional: empty tiers inherit MODEL_LOW; empty HIGH_BASE_URL uses the primary endpoint.
MODEL_MEDIUM=
MODEL_HIGH=
HIGH_BASE_URL=
HIGH_API_KEY=
MODEL_VISION=
# Provider-specific extras: enable only when the selected provider supports them.
LLM_THINKING_PARAMETER=false
LLM_WEB_SEARCH_ENABLED=false
# Optional cloud document parser. Plain Markdown needs no parser service.
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net
